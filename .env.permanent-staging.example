# Permanent development/staging (IGNORED — copy to .env.permanent-staging locally)
# NEVER put real keys in this example. NEVER use VITE_ for service-role.
# NEVER point these values at production (denied prefix nsne).
# NEVER reuse disposable evidence credentials here without an explicit owner decision.
# Suggested project name (not created until the owner authorizes a generated ref):
#   babydragon-permanent-staging
# Connection: Session Pooler for approved migrations; app uses public URL + anon key.

# --- Canonical staging identity (Decision 5) ---
BABYDRAGON_STAGING_PROJECT_NAME=
BABYDRAGON_STAGING_PROJECT_REF=
BABYDRAGON_STAGING_SUPABASE_URL=
BABYDRAGON_STAGING_ANON_KEY=
BABYDRAGON_STAGING_SERVICE_ROLE_KEY=
BABYDRAGON_STAGING_DATABASE_URL=
BABYDRAGON_STAGING_DB_PASSWORD=
BABYDRAGON_STAGING_SA_EMAIL=
BABYDRAGON_STAGING_SA_PASSWORD=
BABYDRAGON_STAGING_ADMIN_EMAIL=
BABYDRAGON_STAGING_ADMIN_PASSWORD=
BABYDRAGON_STAGING_FE_EMAIL=
BABYDRAGON_STAGING_FE_PASSWORD=

# --- Compatible CR1-E cutover-gate aliases (same local values; do not mix with production) ---
# Policy flag names only. Example values stay closed.
# Local dry-run identity gate (gitignored .env.permanent-staging, not this file):
#   F10C2_PERMANENT_STAGING_CONFIRMED=yes
#   F10C2_PERMANENT_STAGING_NOT_PRODUCTION=yes
#   F10C2_PERMANENT_STAGING_SQL_EXECUTION_APPROVED=no
#   F10C2_PERMANENT_STAGING_217_EXECUTION_APPROVED=no
#   F10C2_PERMANENT_STAGING_AUTH_SEED_APPROVED=no
#   F10C2_PERMANENT_STAGING_CONNECTION_METHOD=session-pooler
#   F10C2_PERMANENT_STAGING_APPROVED_GIT_SHA=
# SQL execution remains no until the owner gives a later explicit apply approval.
# 217 uses its own flag. Do not reuse F10C2_PERMANENT_STAGING_SQL_EXECUTION_APPROVED for 217.
# Auth/Class A seed uses F10C2_PERMANENT_STAGING_AUTH_SEED_APPROVED. Do not reuse the SQL flags.
F10C2_PERMANENT_STAGING_CONFIRMED=no
F10C2_PERMANENT_STAGING_ENVIRONMENT_NAME=
F10C2_PERMANENT_STAGING_PROJECT_NAME=
F10C2_PERMANENT_STAGING_PROJECT_REF=
F10C2_PERMANENT_STAGING_NOT_PRODUCTION=no
F10C2_PERMANENT_STAGING_CONNECTION_METHOD=session-pooler
F10C2_PERMANENT_STAGING_SQL_EXECUTION_APPROVED=no
F10C2_PERMANENT_STAGING_217_EXECUTION_APPROVED=no
F10C2_PERMANENT_STAGING_AUTH_SEED_APPROVED=no
F10C2_PERMANENT_STAGING_APPROVED_GIT_SHA=
F10C2_PERMANENT_STAGING_SUPABASE_URL=
F10C2_PERMANENT_STAGING_ANON_KEY=
F10C2_PERMANENT_STAGING_SERVICE_ROLE_KEY=
F10C2_PERMANENT_STAGING_DB_URL=

# Denied production (names only — used by fail-closed guards)
F10C2_DENIED_PRODUCTION_REF=
F10C2_DENIED_PRODUCTION_DB_HOST=

# Seed policy
F10C2_PERMANENT_STAGING_SEED_SYNTHETIC_FIELD_RESULTS=no
F10C2_PRODUCTION_DATA_IMPORT=disabled

# Optional staging Auth emails (aliases of BABYDRAGON_STAGING_*). Leave password values empty in git.
F10C2_PERMANENT_STAGING_SA_EMAIL=
F10C2_PERMANENT_STAGING_SA_PASSWORD=
F10C2_PERMANENT_STAGING_ADMIN_EMAIL=
F10C2_PERMANENT_STAGING_ADMIN_PASSWORD=
F10C2_PERMANENT_STAGING_FE_EMAIL=
F10C2_PERMANENT_STAGING_FE_PASSWORD=
