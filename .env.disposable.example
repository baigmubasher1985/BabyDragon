# F10C2 Phase 4 disposable / Phase 4B-P target (IGNORED — copy to .env.disposable locally)
# NEVER put real keys in this example. NEVER use VITE_ for service-role.
# NEVER point these values at the production project.

F10C2_DISPOSABLE_CONFIRMED=no
F10C2_DISPOSABLE_PROJECT_NAME=babydragon-f10c2-disposable
F10C2_DISPOSABLE_PROJECT_REF=
F10C2_DISPOSABLE_SUPABASE_URL=
F10C2_DISPOSABLE_ANON_KEY=
F10C2_DISPOSABLE_SERVICE_ROLE_KEY=
F10C2_DISPOSABLE_DB_URL=
F10C2_DENIED_PRODUCTION_REF=
F10C2_DENIED_PRODUCTION_DB_HOST=

# Phase 4B extra gates (required before any later SQL execution)
F10C2_SYNTHETIC_DATA_MODE=no
F10C2_PRODUCTION_DATA_IMPORT=disabled
F10C2_PHASE4B_SQL_EXECUTION_APPROVED=no
F10C2_PHASE4B_CLEANUP_CONFIRMED=no
F10C2_PHASE4B_BOOTSTRAP_CLEANUP_CONFIRMED=no

# Optional synthetic Auth emails only (no production identities)
F10C2_DISPOSABLE_FE_EMAIL=fe.synthetic.f10c2@invalid.test
F10C2_DISPOSABLE_FE_PASSWORD=
F10C2_DISPOSABLE_ADMIN_EMAIL=admin.synthetic.f10c2@invalid.test
F10C2_DISPOSABLE_ADMIN_PASSWORD=
F10C2_DISPOSABLE_SA_EMAIL=sa.synthetic.f10c2@invalid.test
F10C2_DISPOSABLE_SA_PASSWORD=
